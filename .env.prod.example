# Copie para .env no servidor e preencha. NUNCA versione o .env (esta no .gitignore).

# ===== Banco (MySQL) =====
MYSQL_ROOT_PASSWORD=TROCAR_root
MYSQL_DATABASE=importaai
IMPORTAAI_DB_USERNAME=importaai
IMPORTAAI_DB_PASSWORD=TROCAR_db

# ===== RabbitMQ =====
IMPORTAAI_RABBITMQ_USERNAME=importaai
IMPORTAAI_RABBITMQ_PASSWORD=TROCAR_rabbit

# ===== JWT (gere com: openssl rand -base64 48) =====
IMPORTAAI_JWT_SECRET=TROCAR_por_segredo_aleatorio_de_64+_chars

# ===== Origem do tunel (CORS/WebSocket) =====
# Cloudflare quick tunnel (URL aleatoria): use o wildcard abaixo.
# localtunnel: troque por https://importaai.loca.lt
TUNNEL_ORIGIN=https://*.trycloudflare.com

# ===== Correios CWS (rastreamento real — auth por cartao de postagem) =====
# So necessarias quando CORREIOS_ADAPTER=http. Deixe em branco para usar o stub.
IMPORTAAI_CORREIOS_USUARIO=
IMPORTAAI_CORREIOS_CODIGO_ACESSO=
IMPORTAAI_CORREIOS_CARTAO_POSTAGEM=
