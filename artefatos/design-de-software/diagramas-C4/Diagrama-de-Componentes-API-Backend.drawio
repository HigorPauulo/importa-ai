        <mxCell id="comp-cartouche" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontColor=light-dark(#000000,#DDDDDD);" value="&lt;div style=&quot;font-size: 14px; font-weight: bold; margin-bottom: 6px;&quot;&gt;Diagrama de Componentes — API Backend&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;Nível 3 · C4 Model · Arquitetura Hexagonal&lt;/div&gt;&lt;div style=&quot;font-size: 10px; margin-top: 6px;&quot;&gt;Versão 1.0 · 11/05/2026&lt;/div&gt;&lt;div style=&quot;font-size: 10px;&quot;&gt;Autor: Higor Paulo Costa&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="310" x="-355" y="140" as="geometry" />
        </mxCell>
        <mxCell id="comp-sticky-hexagonal" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4D2;strokeColor=#D4B656;align=left;verticalAlign=top;fontColor=#404040;fontSize=10;spacing=10;" value="&lt;div style=&quot;font-weight: bold; margin-bottom: 4px;&quot;&gt;ⓘ Arquitetura Hexagonal — Inversão de dependência&lt;/div&gt;&lt;b&gt;Application&lt;/b&gt; (Use Cases) depende de &lt;b&gt;Ports&lt;/b&gt; (interfaces declaradas no Domain).&lt;br/&gt;&lt;b&gt;Adapters OUT&lt;/b&gt; implementam essas ports — &lt;i&gt;RabbitMQEventPublisher implements EventPublisher&lt;/i&gt;.&lt;br/&gt;Trocar RabbitMQ por Kafka exigiria apenas um novo adapter, sem tocar em Use Case nem Domain.&lt;br/&gt;O &lt;b&gt;Domain&lt;/b&gt; é Java puro: zero &lt;code&gt;org.springframework&lt;/code&gt;." vertex="1">
          <mxGeometry height="170" width="540" x="600" y="160" as="geometry" />
        </mxCell>
        <mxCell id="comp-sticky-fluxo" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4D2;strokeColor=#D4B656;align=left;verticalAlign=top;fontColor=#404040;fontSize=10;spacing=10;" value="&lt;div style=&quot;font-weight: bold; margin-bottom: 4px;&quot;&gt;ⓘ Fluxo de escrita (RN03 + RN04)&lt;/div&gt;&lt;b&gt;1.&lt;/b&gt; Controller → CriarPedidoUseCase&lt;br/&gt;&lt;b&gt;2.&lt;/b&gt; UseCase publica via EventPublisher → Broker (Publisher Confirms, RNF05)&lt;br/&gt;&lt;b&gt;3.&lt;/b&gt; Controller retorna &lt;b&gt;HTTP 202&lt;/b&gt; sem aguardar persistência (RN03)&lt;br/&gt;&lt;b&gt;4.&lt;/b&gt; Consumer persiste com UNIQUE em evento_processado (RN04)" vertex="1">
          <mxGeometry height="170" width="450" x="1180" y="160" as="geometry" />
        </mxCell>
        <object placeholders="1" c4Name="WebSocketNotificationSender" c4Type="Component" c4Technology="Spring STOMP" c4Description="Implementa NotificationSender. Envia para /user/{id}/queue/notificacoes." label="&lt;font style=&quot;font-size: 16px&quot;&gt;&lt;b&gt;%c4Name%&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[%c4Type%: %c4Technology%]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;%c4Description%&lt;/font&gt;&lt;/div&gt;" id="c1RuQ6m2GqWgeHDWqU3e-38">
